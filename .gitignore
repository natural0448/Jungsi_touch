# Data-work scripts are local by default: existing scripts include actual
# recruitment rows, quotas, source mappings and previous data-patch versions.
# Only reviewed generic entry points and explicitly synthetic demos are shared.
/scripts/*
!/scripts/calculate_overall_percentile.py
!/scripts/analyze_exam_score.py
!/scripts/compare_year_scores.py
!/scripts/demo_profile_percentile.py
!/scripts/demo_school_screening.py
