# Jungsi_touch: source code in Git, private data outside Git.
# No .env example exception: all environment files stay local.

# Environment files at every directory depth
.env
.env.*
*.env
*.env.*
.[eE][nN][vV]
.[eE][nN][vV].*
*.[eE][nN][vV]
*.[eE][nN][vV].*

# Private source materials, 3-tier data layer, and generated outputs.
# No leading slash: the same directory names are excluded at every depth.
Resource/
data/
datas/
outputs/
# Portable protection against case variants, including DATA and Data.
[rR][eE][sS][oO][uU][rR][cC][eE]/
[dD][aA][tT][aA]/
[dD][aA][tT][aA][sS]/
[oO][uU][tT][pP][uU][tT][sS]/

