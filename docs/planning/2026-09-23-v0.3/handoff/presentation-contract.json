{
  "contract_version": "0.3-draft",
  "status": "design_only",
  "description": "프레젠테이션과 서버의 경계 설명용 계약. 실행 API 및 OpenAPI 문서가 아님.",
  "decisions": {
    "collaborator_access": "all_code_and_data",
    "primary_users": [
      "학생",
      "학부모"
    ],
    "secondary_users": [
      "교사",
      "입시담당자"
    ],
    "technology_stack": "undecided",
    "release_academic_year": "undecided",
    "browser_secrets": "none",
    "data_source_for_fixtures": "synthetic_only"
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/admissions",
      "query_fields": [
        "academic_year",
        "university_query",
        "admission_group",
        "region",
        "cursor"
      ],
      "auth_policy": "성적 입력 불필요. 익명/로그인 열람 정책은 미정이며 서버가 선택한 정책을 집행.",
      "response_type": "AdmissionsResponse",
      "limits": "페이지 크기와 필터 길이는 서버 제한. 운영 수치는 미정."
    },
    {
      "method": "POST",
      "path": "/api/v1/score-comparisons",
      "request_type": "ComparisonRequest",
      "response_type": "ComparisonResponse",
      "auth_policy": "서버 발급 세션 및 선택한 이용 정책 검증. 익명 세션/회원 로그인 여부는 미정.",
      "limits": "성적 한 사례와 제한된 후보 목록. 후보 수·요청량 한도는 서버가 결정.",
      "error_type": "ErrorResponse"
    }
  ],
  "types": {
    "AdmissionsResponse": {
      "allowed_fields": [
        "data_kind",
        "academic_year",
        "public_release_id",
        "items",
        "next_cursor"
      ],
      "required_fields": [
        "data_kind",
        "academic_year",
        "public_release_id",
        "items",
        "next_cursor"
      ],
      "nested_fields": {
        "items": {
          "kind": "array",
          "type": "AdmissionRecord"
        }
      }
    },
    "AdmissionRecord": {
      "allowed_fields": [
        "offering_id",
        "university_name",
        "admission_unit_name",
        "selection_name",
        "admission_group",
        "quota_count",
        "quota_status",
        "result_metric",
        "source_label"
      ],
      "required_fields": [
        "offering_id",
        "university_name",
        "admission_unit_name",
        "selection_name",
        "admission_group",
        "quota_count",
        "quota_status",
        "result_metric",
        "source_label"
      ]
    },
    "ComparisonRequest": {
      "allowed_fields": [
        "exam_academic_year",
        "score_profile",
        "offering_ids"
      ],
      "required_fields": [
        "exam_academic_year",
        "score_profile",
        "offering_ids"
      ],
      "nested_fields": {
        "score_profile": {
          "kind": "object",
          "type": "ScoreProfile"
        }
      }
    },
    "ScoreProfile": {
      "allowed_fields": [
        "korean",
        "math",
        "inquiry",
        "english_grade",
        "korean_history_grade"
      ],
      "required_fields": [
        "korean",
        "math",
        "inquiry",
        "english_grade",
        "korean_history_grade"
      ],
      "nested_fields": {
        "korean": {
          "kind": "object",
          "type": "SubjectScore"
        },
        "math": {
          "kind": "object",
          "type": "SubjectScore"
        },
        "inquiry": {
          "kind": "array",
          "type": "SubjectScore"
        }
      }
    },
    "SubjectScore": {
      "allowed_fields": [
        "subject_id",
        "standard_score",
        "percentile",
        "grade"
      ],
      "required_fields": [
        "subject_id",
        "standard_score",
        "percentile",
        "grade"
      ]
    },
    "ComparisonResponse": {
      "allowed_fields": [
        "data_kind",
        "request_id",
        "academic_year",
        "public_release_id",
        "results"
      ],
      "required_fields": [
        "data_kind",
        "request_id",
        "academic_year",
        "public_release_id",
        "results"
      ],
      "nested_fields": {
        "results": {
          "kind": "array",
          "type": "ComparisonResult"
        }
      }
    },
    "ComparisonResult": {
      "allowed_fields": [
        "offering_id",
        "calculation_status",
        "converted_score",
        "score_maximum",
        "percentile",
        "source_label"
      ],
      "required_fields": [
        "offering_id",
        "calculation_status",
        "converted_score",
        "score_maximum",
        "percentile",
        "source_label"
      ],
      "nested_fields": {
        "percentile": {
          "kind": "object",
          "type": "PercentileResult"
        }
      }
    },
    "PercentileResult": {
      "allowed_fields": [
        "status",
        "ratio_gt",
        "ratio_ge",
        "population_label",
        "estimate_notice",
        "unavailable_reason"
      ],
      "required_fields": [
        "status",
        "ratio_gt",
        "ratio_ge",
        "population_label",
        "estimate_notice",
        "unavailable_reason"
      ]
    },
    "ErrorResponse": {
      "allowed_fields": [
        "error"
      ],
      "required_fields": [
        "error"
      ],
      "nested_fields": {
        "error": {
          "kind": "object",
          "type": "ApiError"
        }
      }
    },
    "ApiError": {
      "allowed_fields": [
        "code",
        "message",
        "request_id",
        "retry_after_seconds"
      ],
      "required_fields": [
        "code",
        "message",
        "request_id",
        "retry_after_seconds"
      ]
    }
  },
  "value_rules": [
    "data_kind는 synthetic/published를 구분한다. 첨부 응답 fixture는 모두 synthetic이다.",
    "academic_year는 정수. 2026은 가상 응답의 예시이며 출시 학년도 결정이 아니다.",
    "내부 및 응답 누적비율은 0~1. 프레젠테이션만 표시할 때 100을 곱한다.",
    "percentile.status=unavailable이면 ratio_gt와 ratio_ge는 null이며 사유가 있어야 한다.",
    "추정 비율은 0 <= ratio_gt <= ratio_ge <= 1. 동점 구간과 모델 불확실성 구간은 구분한다.",
    "request의 과목 코드·점수 범위·조합은 해당 학년도 공식 기준으로 서버에서 추가 검증한다.",
    "result_metric에는 공개 승인된 지표 정의와 값을 둘 수 있다. 이 초안의 null은 아직 자료가 없음을 뜻한다."
  ],
  "forbidden_browser_payloads": [
    "database_credentials",
    "service_secret_keys",
    "raw_population_records",
    "full_percentile_tables",
    "proprietary_model_parameters",
    "internal_source_paths",
    "sql_and_stack_traces"
  ],
  "security_requirements": [
    "응답은 서버에서 공개 필드 허용 목록으로 구성한다.",
    "클라이언트 역할, 가격, 쿼터, 관리자 여부를 요청값만으로 신뢰하지 않는다.",
    "개인 결과의 객체 접근권한은 저장 기능 도입 시 매 요청에 확인한다.",
    "후보 수·호출 비용·누적 요청 제한과 비정상 반복 조회 탐지를 서버에서 집행한다.",
    "구체적인 인증·CSRF·캐시·로깅 구현은 스택 선정 후 검증한다."
  ],
  "fixture_files": {
    "admissions.mock.json": "AdmissionsResponse",
    "comparison.request.mock.json": "ComparisonRequest",
    "comparison.response.mock.json": "ComparisonResponse",
    "rate-limit.error.mock.json": "ErrorResponse"
  },
  "document_role": "historical_snapshot",
  "current_spec_path": "docs/current/service_spec.json",
  "current_routing_path": "docs/current/라우팅_명세.md"
}
