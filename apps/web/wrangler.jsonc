{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 2026-10-05 사용자(정시터치 최종 관리자) 결정: 에듀터치 본체가 /jeongsi 를 넘기는 기존 jeongsi-touch 워커를
  // 이 앱으로 교체한다(본체 JEONGSI_PREVIEW_ORIGIN 은 그대로). 되돌릴 때는 `wrangler rollback` 으로 이전 판을 다시 올린다.
  "name": "jeongsi-touch",
  "main": "worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // 2026-11-10 사용자 요청(화면이 부드럽게 열리게): 화면 서버를 정시터치 함수·에듀터치 Supabase(서울) 가까이에서 돌린다.
  // 한 화면에 서버 요청이 3~5건 차례로 나가는데, 지금은 한국 요청이 LA 입구에서 실행돼 건마다 태평양을 오간다.
  // Cloudflare 가 실제 요청 시간을 보고 실행 위치를 정한다(추가 비용 없음, 정적 파일은 그대로 가까운 곳에서).
  // 되돌릴 때는 이 줄을 지우고 다시 배포한다.
  "placement": { "mode": "smart" },
  // 2026-10-20 사용자 결정: 1페이지 대학 발표 입시결과(개인 정보 없는 공개 발표 자료) 조회 결과를 회원끼리 잠시 공유 저장해
  // 같은 조건을 다시 부르지 않는다(lib/shared-cache.ts). 워커가 workers.dev 로 연결돼 Cache API 가 동작하지 않아 KV 를 쓴다
  // 2026-11-28 속도 P1: 판정 서버를 내부 연결로 부른다(코드는 주소가 Cloudflare 판정 서버일 때만 쓴다)
  "services": [
    { "binding": "JUNGSI_API_SVC", "service": "jungsi-api-prod" },
    { "binding": "JUNGSI_PRO_API_SVC", "service": "jungsi-pro-api-prod" }
  ],
  "kv_namespaces": [
    { "binding": "JT_SHARED_CACHE", "id": "67431841ff264ded90c2a53f89c8b0a6" }
  ],
  // Source preparation only. Owner must review resource registration before deployment.
  "durable_objects": {
    "bindings": [{ "name": "JT_P1_COORDINATOR", "class_name": "P1SnapshotCoordinator" }]
  },
  "migrations": [{ "tag": "p1-coordinator-v1", "new_sqlite_classes": ["P1SnapshotCoordinator"] }],
  "vars": {
    // 우리 서비스 API 주소(애플리케이션 계층)는 담당자가 운영 주소를 주면 "JUNGSI_API_URL" 로 넣는다. 비밀값이 아니다.
    // synthetic: 명시적으로 고른 화면 제작·검토용 합성 응답 / live: 우리 서비스 API + 에듀터치 Supabase 로그인
    // 값이 없거나 live 설정(JUNGSI_API_URL, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY)이 빠지면
    // 화면은 '연결 설정 대기'를 보인다. 실서버가 실패해도 합성 응답으로 바꾸지 않는다(DEV-006).
    // Supabase 두 값은 에듀터치 본체(web)와 같은 프로젝트의 URL·publishable 키다(비밀값이 아니다).
    // 2026-10-06 사용자 결정: 운영 API 주소를 받기 전까지 배포 화면을 예시 응답(synthetic)으로 둔다.
    // 상단 '합성 응답' 띠가 보인다. 주소가 오면 "live" 와 JUNGSI_API_URL·Supabase 두 값을 넣어 다시 배포한다.
    // 2026-10-16 사용자 결정: Supabase 설정 5개 등록·readiness 통과 뒤 실제 연결(live)로 바꾼다. 오픈 전 관문은 그대로 둔다.
    // 주소에는 /api/v1 을 붙이지 않는다(live.ts 가 붙인다). relay 는 워커 Secret JUNGSI_RELAY_TOKEN(소유자 등록).
    "JUNGSI_API_MODE": "live",
    "JUNGSI_API_URL": "https://ksrpnhvyfdwysrexdhrd.supabase.co/functions/v1/jungsi-api",
    // 성적 입력 시험 식별자(비밀값 아님). 없으면 lib/exam.ts 가 합성 토큰을 보내 서버가 저장을 거절한다(2026-10-16 실측).
    // 승인 binding·시험팩의 값과 같아야 한다. 시험이 바뀌면 담당자가 알려 준 값으로 함께 바꾼다
    // 2026-11-21 대표님 확정: 관리자만 접근 가능한 지금 바로 가채점으로 전환해 미리 확인한다(JUNGSI_CSAT_OPENS_AT = 2026-11-21 21:00 KST, 운영 26번째 갱신행과 같은 값 — 대표님 지시로 최대한 앞당김).
    // 화면이 요청마다 지금 시각과 비교해 고르므로(lib/exam.ts csatOpen) 전환 전에 배포해도 그 시각까지는 9월 화면 그대로다.
    // JUNGSI_EXAM_ID·JUNGSI_PACK_VERSION = 수능 가채점(전환 뒤 지금 시험), JUNGSI_PAST_* = 9월 모의평가(전환 전 지금 시험, 뒤에는 지난 기록)
    "JUNGSI_EXAM_ID": "2027-csat-provisional",
    "JUNGSI_PACK_VERSION": "20261122.csat-provisional-v52.v1",
    "JUNGSI_PAST_EXAM_ID": "2027-september-mock",
    "JUNGSI_PAST_PACK_VERSION": "20260930.v1",
    "JUNGSI_CSAT_OPENS_AT": "2026-11-21T12:00:00Z",
    // 2026-11-21 전문가용 개통(대표님 결정: 오픈 때 개인용과 함께, 가채점 입력 포함). URL 끝에 / 나 /api/v1 을 붙이지 않는다(pro-source.ts 가 붙임). BFF origin 은 서버 설정 approved_bff_origin 과 같아야 한다
    // 2026-11-27 Cloudflare 이전(대표님 승인: 전문가용 호출 한 번 약 1초). 되돌림: 아래 Supabase 주소로 바꿔 배포 또는 이전 화면 판으로 wrangler rollback
    // 옛 주소: https://ksrpnhvyfdwysrexdhrd.supabase.co/functions/v1/jungsi-pro-api
    "JUNGSI_PRO_API_URL": "https://jungsi-pro-api-prod.edutouch-web.workers.dev/jungsi-pro-api",
    "JUNGSI_PRO_BFF_ORIGIN": "https://edutouch.co.kr",
    "JUNGSI_PRO_CSAT_ENABLED": "1",
    "JUNGSI_CURRENT_REVIEW_URL": "https://ksrpnhvyfdwysrexdhrd.supabase.co/functions/v1/current-admission-review",
    // 2026-10-13 사용자 결정: 오픈 전에는 에듀터치 관리자와 허용 명단(JEONGSI_PREVIEW_EMAILS, wrangler secret)만
    // 들어온다(src/proxy.ts). Supabase 두 공개값은 빌드 때 .env.production(Git 제외)으로 넣는다. 오픈 때 지운다.
    "JEONGSI_ACCESS_GATE": "preview"
  }
}
