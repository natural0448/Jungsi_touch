      [
        "total_model_invalid",
        "공급 객체 또는 모델 계산 형식 불일치"
      ],
      [
        "total_model_not_approved",
        "운영 승인되지 않은 총점 곡선"
      ],
      [
        "model_version_mismatch",
        "서버 채택 분포 버전과 공급 모델의 분포 ID 불일치"
      ],
      [
        "model_exam_mismatch",
        "학생과 총점 모델 시험 ID 불일치"
      ],
      [
        "model_pack_mismatch",
        "공식 시험 자료 버전과 총점 모델 연결 불일치"
      ],
      [
        "model_population_mismatch",
        "공식 유효 국수탐2 모집단의 인원 범위·확인 분모 불일치"
      ],
      [
        "academic_year_mismatch",
        "학생과 총점 모델 학년도 불일치"
      ],
      [
        "score_outside_domain",
        "입력 총점이 모델 검증 범위 밖"
      ],
      [
        "model_not_ready",
        "계산 엔진 승인 검사 미통과"
      ],
      [
        "model_provider_hash_mismatch",
        "Drive 자료 내용 해시 불일치"
      ],
      [
        "model_provider_version_mismatch",
        "Drive 파일 또는 발행 명부 버전 불일치"
