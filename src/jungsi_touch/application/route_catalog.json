  "overall_analysis_contract": {
    "operation": "overall.analyze",
    "application_service": "jungsi_touch.application.overall_analysis.OverallAnalysisService.analyze",
    "format": "jungsi.overall-analysis/v1",
    "stateless": true,
    "http_handler_implemented": false,
    "description": "검증된 서버 Actor를 먼저 확인한 뒤 등록 시험과 자료 버전의 학생 성적을 기존 ExamPack으로 분석한다. 누적곡선의 부재·미승인·불일치는 전체 입력 오류가 아니라 overall.pending으로 반환하고 총점과 과목 결과를 보존한다.",
    "required_inputs": [
      "exam_id",
      "pack_version",
      "korean",
      "math",
      "inquiry"
    ],
    "optional_inputs": [
      "english_grade",
      "korean_history_grade"
    ],
    "input_rules": [
      "exam_id·pack_version은 등록 ID 토큰이며 파일 경로가 아니다",
      "국어·수학은 standard_score와 선택적 choice만 허용",
      "inquiry는 서로 다른 두 과목의 subject·standard_score",
      "점수·등급·선택과목 검증은 기존 시험 엔진에 위임",
      "학생 ID·유료 플래그·자료 경로·research·승인 상태·동점 정책 입력은 거부"
    ],
    "response_fields": [
      "format",
      "exam",
      "pack_version",
      "score_basis",
      "total_standard_score",
      "subjects",
      "absolute_grades",
      "overall"
    ],
    "exam_fields": [
      "exam_id",
      "academic_year",
      "exam_type"
    ],
    "subject_fields": [
      "area",
      "subject",
      "choice",
      "standard_score",
      "grade",
      "top_percent_exclusive",
      "top_percent_inclusive",
      "basis"
    ],
    "overall_fields": [
      "status",
      "reason_code",
      "top_percent",
      "inclusive_top_percent",
      "exclusive_top_percent",
      "tie_share_percent",
      "tie_interval_percent",
      "tie_policy",
      "population_id",
      "model_version"
    ],
    "overall_statuses": [
      "observed",
      "estimated",
      "pending"
    ],
    "number_format": "누적 값은 0~100의 소수 문자열이며 내부 도수·가중치는 반환하지 않는다",
    "tie_policy": "include_equal; 포함/제외 값과 동점 구간도 표시. 동점 범위는 모형 신뢰구간이나 합격확률이 아님",
    "provider": "application.ports.ExamAnalysisProvider: get_exam_pack(exam_id), get_total_model(exam_id, pack_version). 총점 공급값은 서버 채택 distribution_id를 결속한 TotalModelBinding 또는 미발행 None",
    "model_validation": [
      "서버 채택 distribution_id와 공급 모델 버전 일치",
      "approved 상태와 시험 ID·자료 버전·학년도·전체 국수탐2 모집단·분모·조회 범위 검증",
      "미승인 자료를 연구 옵션으로 실행하거나 요청값으로 승인 승격하지 않음"
    ],
    "pending_reasons": [
